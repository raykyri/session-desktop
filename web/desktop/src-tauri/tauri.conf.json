{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session",
  "version": "0.1.0",
  "identifier": "dev.session.spaces",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1490",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Session",
        "width": 1320,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://session.app https://pbs.twimg.com https://abs.twimg.com https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://session.app; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity"
  }
}

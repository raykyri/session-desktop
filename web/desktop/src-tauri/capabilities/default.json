{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window, from the app's own pages: its title, the person's replica, the Keychain item, what the app is, and http, https and mailto links in the system's apps.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "allow-replica-open",
    "allow-replica-select",
    "allow-replica-batch",
    "allow-replica-close",
    "allow-replica-delete",
    "allow-keychain-get",
    "allow-keychain-set",
    "allow-keychain-delete",
    "allow-app-about",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }]
    }
  ]
}

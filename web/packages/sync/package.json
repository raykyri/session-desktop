  "scripts": {
    "test": "ava",
    "sim": "SYNC_SIM_SEEDS=1000 ava test/simulation.test.ts"
  },
  "dependencies": {
    "@session/mutators": "*",
    "@session/shared": "*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.0"
  }
}

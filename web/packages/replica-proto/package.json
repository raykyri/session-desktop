{
  "name": "@session/replica-proto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "ava",
    "test:package": "REPLICA_PROTO_MUTATORS=package ava",
    "test:sync": "REPLICA_PROTO_MUTATORS=package REPLICA_PROTO_SERVER=sync-memory ava",
    "test:sync-sqlite": "REPLICA_PROTO_MUTATORS=package REPLICA_PROTO_SERVER=sync-sqlite ava",
    "mutate": "tsx test/mutations/mutate.ts",
    "mutate:package": "tsx test/mutations/mutate.ts --package",
    "mutate:sync": "tsx test/mutations/mutate.ts --sync",
    "test:http": "REPLICA_PROTO_MUTATORS=package REPLICA_PROTO_SERVER=http ava"
  },
  "devDependencies": {
    "@session/server": "*",
    "better-sqlite3": "^13.0.3"
  },
  "dependencies": {
    "@session/mutators": "*",
    "@session/shared": "*",
    "@session/sync": "*",
    "zod": "^4.6.5"
  }
}

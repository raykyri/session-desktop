{
  "name": "@session/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/src/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/app.d.ts",
      "default": "./src/app.ts"
    },
    "./router": {
      "types": "./dist/src/trpc/router.d.ts",
      "default": "./src/trpc/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "test": "ava"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@session/db": "*",
    "@session/shared": "*",
    "@trpc/server": "^11.19.0",
    "arctic": "^3.7.0",
    "hono": "^4.13.8",
    "mammoth": "^1.12.3",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}

{
  "name": "session-web",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev --workspace @session/server\" \"npm run dev --workspace @session/client\"",
    "build": "tsc -b && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "echo 'Playwright e2e arrives with Phase 6 (docs/12-testing-linting-ci.md 3.6)' && exit 1",
    "lint": "eslint . && prettier --check .",
    "check": "tsc -b && npm run lint",
    "db:generate": "npm run db:generate --workspace @session/db --if-present",
    "db:migrate": "npm run db:migrate --workspace @session/db --if-present",
    "db:studio": "npm run db:studio --workspace @session/db --if-present",
    "db:admin": "npm run db:admin --workspace @session/db --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.1",
    "ava": "^8.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}

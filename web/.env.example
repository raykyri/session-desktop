# Session Web — environment variables
#
# Copy to .env for local development (`npm run dev` loads it). In production,
# set non-secret values in fly.toml [env] and secrets with `fly secrets set`.
# Every variable below is read once at boot by packages/server/src/config.ts,
# which validates it with zod and refuses to start on malformed values.

# ─── Server ──────────────────────────────────────────────────────────────────

# Bind address and port for the web server. Fly sets these itself.
HOST=127.0.0.1
PORT=8787

# development | production | test. Controls cookie Secure flag, logging, and
# whether test-only routes are allowed.
NODE_ENV=development

# Public origin of the app (scheme + host, no path). Used for OAuth callbacks,
# CSRF origin checks, and the OpenRouter attribution header.
SESSION_PUBLIC_ORIGIN=http://localhost:1480

# Origin that serves attached-document previews inside the sandboxed iframe.
# Must be a different host from SESSION_PUBLIC_ORIGIN so the session cookie
# never reaches it. Locally, a second loopback name works.
SESSION_ARTIFACT_ORIGIN=http://artifacts.localhost:8787

# Directory holding session.db, documents/, and tmp/. A Fly volume in prod.
SESSION_DATA_DIR=./.data

# ─── Authentication ──────────────────────────────────────────────────────────

# GitHub OAuth app. Callback URL to register: ${SESSION_PUBLIC_ORIGIN}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional comma-separated GitHub logins allowed to sign in. Unset = open sign-up.
SESSION_ALLOWED_GITHUB_LOGINS=

# Set to 1 to require an invite code at sign-up (codes are created by admins).
SESSION_REQUIRE_INVITE=0

# ─── Models ──────────────────────────────────────────────────────────────────
# A model whose credential is missing is reported as unavailable and hidden.

# Gemini 3.8 Flash on Vertex AI (default model; also runs titles, recaps, and
# encyclopedia pages). Paste the service-account key JSON as one line; the
# server writes it to a file at boot and sets GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global

# OpenRouter serves DeepSeek V4.1 Flash and GPT-5.6 Luna. Every request is
# sent with provider: { zdr: true, data_collection: "deny" }; also enable
# "Zero Data Retention" and disable data collection account-wide in the
# OpenRouter privacy settings so no request can route to a logging provider.
OPENROUTER_API_KEY=

# Claude Fable 5.1 via the Anthropic API. Admin-only model. The Anthropic org
# must be configured for 30-day data retention (Fable is not available under
# zero data retention).
ANTHROPIC_API_KEY=

# ─── Web search (owned web_search tool) ──────────────────────────────────────
# Fill at least one to enable the web_search tool. With neither key set the
# tool is unavailable: models still run with web_fetch and document_read, and
# the composer shows "Web search unavailable"; gemini-flash-google still has
# Google Search grounding. When both are set, SESSION_SEARCH_VENDOR picks the
# primary and the other is the fallback on errors.
PARALLEL_API_KEY=
TAVILY_API_KEY=
# parallel | tavily
SESSION_SEARCH_VENDOR=parallel

# ─── Limits ──────────────────────────────────────────────────────────────────

# Concurrency: research runs per user, and per upstream provider.
SESSION_RUNS_PER_USER=2
SESSION_RUNS_GEMINI=8
SESSION_RUNS_OPENROUTER=8
SESSION_RUNS_ANTHROPIC=2

# Wall-clock cap for one research attempt, in seconds.
SESSION_RUN_TIMEOUT_SECONDS=900

# Daily per-account limits (UTC day). Enforced only when SESSION_ENFORCE_LIMITS=1;
# usage is recorded regardless. Admins are exempt. Per-user overrides live in
# the user_limits table.
SESSION_ENFORCE_LIMITS=0
SESSION_DAILY_TOKENS=1000000
SESSION_DAILY_RUNS=10

# ─── Backups and observability (production) ──────────────────────────────────

# Litestream replica for session.db (s3://bucket/path or similar). Unset = no
# replication. Documents are archived nightly to the same bucket.
LITESTREAM_REPLICA_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional error reporting.
SENTRY_DSN=

# Bearer token protecting GET /metrics. Unset = endpoint disabled.
SESSION_METRICS_TOKEN=

# ─── Development and test switches ───────────────────────────────────────────

# 1 = swap every model for a recorded fixture provider (no credentials needed).
SESSION_FIXTURE_PROVIDERS=0

# 1 = enable POST /auth/test-login (never in production).
SESSION_TEST_AUTH=0

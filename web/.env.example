# ─── Server ──────────────────────────────────────────────────────────────────

HOST=127.0.0.1
PORT=8787
NODE_ENV=development      # development | production | test
SESSION_DATA_DIR=./.data  # Holds session.db, documents/, and tmp/. Use Fly volume in prod.

# Public origin of the app (scheme + host, no path). Used for OAuth callbacks,
# CSRF origin checks, and the OpenRouter attribution header.
SESSION_PUBLIC_ORIGIN=http://localhost:1480

# Origin that serves attached-document previews inside the sandboxed iframe.
# Must be a different host from SESSION_PUBLIC_ORIGIN so the session cookie
# never reaches it. Locally, a second loopback name works.
SESSION_ARTIFACT_ORIGIN=http://artifacts.localhost:8787

# ─── Authentication ──────────────────────────────────────────────────────────

# Register an app and generate a secret: https://github.com/settings/developers
# Callback URL to register: ${SESSION_PUBLIC_ORIGIN}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional comma-separated GitHub logins allowed to sign in. Unset = open sign-up.
SESSION_ALLOWED_GITHUB_LOGINS=

# Set to 1 to require an invite code at sign-up (codes are created by admins).
# Production sets this to 1 (web/fly.toml)
SESSION_REQUIRE_INVITE=0

# ─── Models ──────────────────────────────────────────────────────────────────

# Gemini 3.8 Flash on Vertex AI (default model; titles, recaps, encyclopedia).
# Enable the API:
#   https://console.cloud.google.com/apis/library/aiplatform.googleapis.com
#
# Then create a service account with a name of your choice, the "Vertex AI User"
# role. Go to "Keys" and create a JSON key, and download it here as one line:
#   https://console.cloud.google.com/iam-admin/serviceaccounts
#
# This may require you to enable service account keys for your
# organization, and disable all of these by override:
#
# - iam.disableServiceAccountKeyCreation
# - iam.managed.disableServiceAccountKeyCreation
# - iam.managed.disableServiceAccountApiKeyCreation
#
# You can do this at https://console.cloud.google.com/iam-admin/orgpolicies.

GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global

# OpenRouter serves DeepSeek V4.1 Flash and GPT-5.6 Luna: https://openrouter.ai/keys
# Every request is sent with provider: { zdr: true, data_collection: "deny" };
# also enable "Zero Data Retention" and disable data collection account-wide.
OPENROUTER_API_KEY=

# Claude Fable 5.1, admin-only, needs 30-day retention on the org:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Web search (owned web_search tool) ──────────────────────────────────────

# Provide at least one to enable the web_search tool, otherwise the tool shows
# as unavailable, although models can still run with web_fetch and document_read.
# gemini-flash-google still has Google Search grounding.
#   Parallel: https://platform.parallel.ai
#   Tavily:   https://app.tavily.com
PARALLEL_API_KEY=
TAVILY_API_KEY=
SESSION_SEARCH_VENDOR=parallel   # Default search, parallel | tavily

# ─── Limits ──────────────────────────────────────────────────────────────────

# Concurrency limit, per user, per upstream provider
SESSION_RUNS_PER_USER=2
SESSION_RUNS_GEMINI=8
SESSION_RUNS_OPENROUTER=8
SESSION_RUNS_ANTHROPIC=2

# Queries one account may have waiting at once.
SESSION_QUEUED_PER_USER=20

# Wall-clock time limit for each query, in seconds.
SESSION_RUN_TIMEOUT_SECONDS=900

# Daily per-account limits (UTC day). Enforced only when SESSION_ENFORCE_LIMITS=1;
# usage is recorded regardless. Admins are exempt. Per-user overrides live in
# the user_limits table. Production sets this to 1 (web/fly.toml): a deployment
# that pays per token needs a ceiling, and the default is 0 only so local
# development does not have to think about it.
SESSION_ENFORCE_LIMITS=0
SESSION_DAILY_TOKENS=1000000
SESSION_DAILY_RUNS=10

# ─── Backups and observability (production) ──────────────────────────────────

# Litestream replica for session.db (s3://bucket/path or similar). Unset = no
# replication: the container entrypoint then runs the server directly instead
# of under `litestream replicate -exec` (web/scripts/entrypoint.sh).
LITESTREAM_REPLICA_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where web/scripts/backup-documents.sh ships the nightly archive of
# $SESSION_DATA_DIR/documents. Unset = ${LITESTREAM_REPLICA_URL}/documents.
# The server runs the script itself once a day when either this or
# LITESTREAM_REPLICA_URL is set; with neither, no archive is taken.
# AWS_ENDPOINT_URL_S3 (set by Fly for Tigris) and AWS_REGION are honored by
# the uploader as well.
SESSION_DOCUMENTS_REPLICA_URL=

# Optional error reporting.
SENTRY_DSN=

# Bearer token protecting GET /metrics. Unset = endpoint disabled.
SESSION_METRICS_TOKEN=

# ─── Development and test switches ───────────────────────────────────────────

# 1 = swap every model for a recorded fixture provider (no credentials needed).
SESSION_FIXTURE_PROVIDERS=0

# 1 = enable POST /auth/test-login (never in production).
SESSION_TEST_AUTH=0

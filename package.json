{
  "name": "session",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "dev:site": "TSX_TSCONFIG_PATH=tsconfig.runtime.json tsx watch web/server.tsx",
    "build": "bash scripts/build.sh",
    "build:aarch": "SESSION_BUILD_TARGET=aarch64-apple-darwin bash scripts/build.sh",
    "build:release": "bash scripts/release.sh",
    "build:frontend": "tsc && vite build",
    "build:site:server": "tsc -p web/tsconfig.json && esbuild web/server.tsx --bundle --packages=external --platform=node --format=esm --target=node20 --outfile=dist-site/server.mjs",
    "start:site": "node dist-site/server.mjs",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "npm run test:unit && npm run test:integration && npm run test:rust",
    "test:unit": "npm run test:node -- tests/*.test.ts",
    "test:integration": "npm run test:node -- web/*.test.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "test:app-shortcuts": "npm run test:node -- tests/appShortcuts.test.ts",
    "test:active-workspace": "npm run test:node -- tests/activeWorkspace.test.ts",
    "test:composer-slash-commands": "npm run test:node -- tests/composerSlashCommands.test.ts",
    "test:claude-turns": "npm run test:node -- tests/claudeTurns.test.ts",
    "test:context-menu-placement": "npm run test:node -- tests/contextMenuPlacement.test.ts",
    "test:research-highlights": "npm run test:node -- tests/researchHighlights.test.ts",
    "test:research-navigation": "npm run test:node -- tests/researchNavigation.test.ts",
    "test:research-events": "npm run test:node -- tests/researchEvents.test.ts",
    "test:research-history": "npm run test:node -- tests/researchHistory.test.ts",
    "test:research-folders": "npm run test:node -- tests/researchFolders.test.ts",
    "test:journal": "npm run test:node -- tests/journal.test.ts",
    "test:research-documents": "npm run test:node -- tests/researchDocuments.test.ts",
    "test:research-conversations": "npm run test:node -- tests/researchConversations.test.ts",
    "test:research-threads": "npm run test:node -- tests/researchThreads.test.ts",
    "test:image-markers": "npm run test:node -- tests/imageMarkers.test.ts",
    "test:image-lightbox": "npm run test:node -- tests/imageLightbox.test.ts",
    "test:markdown-math": "npm run test:node -- tests/markdownMath.test.ts",
    "test:research-prompt-markdown": "npm run test:node -- tests/researchPromptMarkdown.test.ts",
    "test:tagged-instructions": "npm run test:node -- tests/taggedInstructions.test.ts",
    "test:research-instruction-setting": "npm run test:node -- tests/researchInstructionSetting.test.ts",
    "test:thread-graph-overlay": "npm run test:node -- tests/threadGraphOverlay.test.ts",
    "test:workspace-scope": "npm run test:node -- tests/workspaceScope.test.ts",
    "test:handoff": "npm run test:node -- tests/handoff.test.ts",
    "tauri": "tauri",
    "test:node": "TSX_TSCONFIG_PATH=tsconfig.runtime.json node --import tsx --test",
    "check:types": "tsc && tsc -p web/tsconfig.json",
    "check:unused": "node scripts/check-unused-modules.mjs",
    "check": "npm run check:types && npm run check:unused && npm run format",
    "preflight": "npm run check && npm test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@viz-js/viz": "^3.28.0",
    "dompurify": "3.4.14",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-mathjax": "^7.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
